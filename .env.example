# PostgreSQL
POSTGRES_USER=boe
POSTGRES_PASSWORD=boe_secret_2026
POSTGRES_DB=boe_sanciones
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://boe:boe_secret_2026@postgres:5432/boe_sanciones
DATABASE_URL_SYNC=postgresql://boe:boe_secret_2026@postgres:5432/boe_sanciones

# Redis
REDIS_URL=redis://redis:6379/0

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-2026-03-05
# Both the environment flag and an explicit manual request are required.
OPENAI_EXTRACTION_ENABLED=false
OPENAI_EXTRACTION_MAX_DOCUMENTS_PER_RUN=1

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL_TO=

# App
BOE_API_BASE_URL=https://www.boe.es/datosabiertos/api/boe
BOE_BASE_URL=https://www.boe.es
SCRAPING_INTERVAL_HOURS=12
GAP_DETECTION_MAX_DAYS=30
LOG_LEVEL=INFO

# Contact enrichment. Disabled and provider-less by default: no code path
# reaches the network unless ENRICHMENT_ENABLED=true AND a concrete provider
# below is configured.
#
# Provider recommendation (deep-research-report (14).md, verified 2026-08-03):
#   1) dataforseo — recommended PRIMARY. Real Google organic SERP, near-zero
#      effective cost (~$0.002/query, Live mode), prepaid balance never
#      expires. Needs a DataForSEO account with a funded balance (their
#      minimum top-up is $50) and the login/password from its dashboard
#      (HTTP Basic auth, not a single API key).
#   2) serper — recommended FALLBACK. 2,500 free queries with no card; after
#      that, credits must be bought in a $50/50k block that expires in 6
#      months, so keep it as a backstop rather than the primary.
#   3) searxng — optional third tier / self-hosted, zero marginal cost but no
#      SLA (depends on upstream engines, can hit CAPTCHAs/429s).
#   4) tavily — NOT RECOMMENDED. Its ToS (updated 2026-05-04) prohibits use
#      for "unsolicited marketing proposals", which is what this feature does.
#      Do not select it without Tavily's written authorization.
#   Google Custom Search and Brave Search API were also researched and ruled
#   out (CSE closed to new customers + shuts down Jan 2027; Brave dropped its
#   free tier in Feb 2026).
ENRICHMENT_ENABLED=false
ENRICHMENT_MODE=on_demand
ENRICHMENT_SEARCH_PROVIDER=none
SEARXNG_URL=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOCATION_NAME=Spain
DATAFORSEO_LANGUAGE_CODE=es
SERPER_API_KEY=
TAVILY_API_KEY=
ENRICHMENT_MIN_CONFIDENCE=0.6
ENRICHMENT_MAX_PAGES_PER_ATTEMPT=5
ENRICHMENT_HTTP_TIMEOUT=10
ENRICHMENT_RATE_LIMIT_PER_DOMAIN_S=2
ENRICHMENT_CACHE_TTL_DAYS=30
ENRICHMENT_RESPECT_ROBOTS=true
# Batch requires BOTH this flag AND an explicit confirmar=true on each request.
ENRICHMENT_BATCH_ENABLED=false
ENRICHMENT_BATCH_MAX=10
ENRICHMENT_USE_LLM_DISAMBIGUATION=false

# Historical index (up to N years) and manual backfill (session 3). Daily
# accumulation is free (reuses text the daily pipeline already downloaded)
# and on by default. The manual backfill over past years is NEVER automatic:
# it requires HISTORICO_BACKFILL_ENABLED=true AND, on every single request, an
# explicit confirmation token that echoes back the exact range and estimated
# volume (see docs/GUIA_OPERATIVA.md). It is not in Celery Beat.
HISTORICO_BACKFILL_ENABLED=false
HISTORICO_BACKFILL_YEARS=4
HISTORICO_BACKFILL_MAX_DIAS_POR_LOTE=5
HISTORICO_BACKFILL_MAX_DOCS_POR_LOTE=200
HISTORICO_BACKFILL_DELAY_S=1
# Storing the downloaded text (and the raw PDF/HTML bytes, archived
# automatically into documento_archivos) is what keeps a document usable
# after the source removes it — on by default.
HISTORICO_BACKFILL_STORE_TEXT=true
HISTORICO_INDEXADO_DIARIO_ENABLED=true
HISTORICO_EXTRACCION_MAX_DOCS_POR_PETICION=3

# Optional TEU public-search connector (session 3): scrapes the TEU's own
# public search form for a single NIF, live, at query time. Off by default.
# The TEU only allows public consultation for 90 days after publication;
# older history is only what this system has itself accumulated since launch
# (see docs/LIMITES.md). Enabling this does not change that limitation.
TEU_PUBLIC_SEARCH_ENABLED=false
TEU_PUBLIC_SEARCH_PROVIDER=none
TEU_PUBLIC_SEARCH_MAX_POR_CONSULTA=50

# Commercial documents (session 3): contrato/factura PDF generation. Nothing
# here is invented — leave blank until Judit provides real fiscal data; the
# API refuses to generate a factura/contrato and lists exactly what is
# missing until these are filled in.
EMISOR_NOMBRE=
EMISOR_CIF=
EMISOR_DIRECCION=
EMISOR_EMAIL=
EMISOR_IVA_PORCENTAJE=21
FACTURA_SERIE=
DOCUMENTOS_DIR=/app/data/documentos

# Email sending (session 3): SMTP send of contrato/factura with attachments.
# Off by default; every send endpoint additionally requires confirmar=true.
# For local testing point SMTP_HOST/SMTP_PORT at the Mailpit dev service
# (docker compose --profile dev-mail up -d mailpit -> smtp on 1025, web UI at
# http://localhost:8025) instead of a real mailbox.
EMAIL_SENDING_ENABLED=false
SMTP_USE_TLS=true
